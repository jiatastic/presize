{
  "name": "presize",
  "version": "0.0.0",
  "description": "Build-time image sizing: AVIF and WebP at the widths you display, a manifest with srcset and ThumbHash, incremental.",
  "license": "MIT",
  "author": "jiatastic520",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiatastic/presize.git"
  },
  "homepage": "https://github.com/jiatastic/presize#readme",
  "bugs": {
    "url": "https://github.com/jiatastic/presize/issues"
  },
  "type": "module",
  "bin": {
    "presize": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY.md"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"test/*.test.ts\"",
    "dev": "node src/cli.ts",
    "prepublishOnly": "pnpm clean && pnpm build && pnpm test",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "sharp": "^0.35.5",
    "thumbhash": "^0.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "image",
    "avif",
    "webp",
    "srcset",
    "responsive-images",
    "thumbhash",
    "build"
  ],
  "packageManager": "pnpm@10.11.0"
}
